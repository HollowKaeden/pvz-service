# Локальные настройки: cp .env.example .env. Makefile подхватывает .env сам.
# Все переменные описаны в README, раздел «Настройки».

# Postgres из compose.yaml (make up). Если порт 5432 занят (например, Postgres
# установлен на машине), поменяйте PG_PORT и порт в DATABASE_URL.
PG_PORT=5432
DATABASE_URL=postgres://pvz:pvz@localhost:5432/pvz?sslmode=disable
MIGRATE_ON_START=true
DB_MAX_CONNS=10

# Ключ подписи токенов, не короче 32 байт. Этот годится только для локального
# запуска; для сервера: openssl rand -hex 32
JWT_SECRET=local-dev-secret-change-me-0123456789

LOG_LEVEL=debug

# Прокси, которым верить в X-Forwarded-For (IP или подсети через запятую).
# Локально прокси нет. На сервере это адрес Caddy.
# TRUSTED_PROXIES=172.30.0.2

# Лимит запросов к /register и /login с одного IP: число/окно. Без переменной
# лимита нет. На сервере 10/1m.
# AUTH_RATE_LIMIT=10/1m
